# Порт HTTP-сервера
PORT=3000

# Хост привязки (0.0.0.0 — все интерфейсы, 127.0.0.1 — только локально)
HOST=0.0.0.0

# Путь к файлу SQLite (относительно server/)
DB_PATH=data/database.db

# Разрешённые источники для CORS (через запятую; * — все)
CORS_ORIGIN=*

# Базовый префикс API
API_PREFIX=/api

# Секрет для подписи сессионных cookie.
# В production — ОБЯЗАТЕЛЕН, задайте длинную случайную строку.
# В development, если пусто — генерируется временный (сессии сбрасываются при перезапуске).
SESSION_SECRET=

# Время жизни сессии в часах
SESSION_TTL_HOURS=12
