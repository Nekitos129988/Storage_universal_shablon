{
	"name": "storage-universal-shablon-server",
	"version": "1.0.0",
	"description": "Серверная часть учёта инвентаря офиса на Bun + Elysia + SQLite",
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun run src/index.ts",
		"seed": "bun run src/db/seed.ts",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@elysiajs/cors": "^1.1.0",
		"@elysiajs/swagger": "^1.1.0",
		"elysia": "^1.4.0",
		"elysia-rate-limit": "^4.6.2",
		"pino": "^10.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@types/bun": "1.3.14",
		"pino-pretty": "^13.1.3"
	},
	"engines": {
		"bun": ">=1.1.0"
	}
}
